{
  "manifest_version": 3,
  "name": "SiteWarden Mail Companion",
  "version": "0.0.1",
  "description": "Companion for the SiteWarden Mail desktop application.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "contextMenus"
  ],
  "action": {
    "default_title": "Open in SiteWarden Mail"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "host_permissions": []
}