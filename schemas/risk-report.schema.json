{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SiteWarden Mail RiskReport",
  "type": "object",
  "required": [
    "report_id",
    "message_id",
    "score",
    "signals"
  ],
  "properties": {
    "report_id": {
      "type": "string"
    },
    "message_id": {
      "type": "string"
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "title",
          "explanation"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "Info",
              "Low",
              "Medium",
              "High",
              "Critical"
            ]
          },
          "title": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}